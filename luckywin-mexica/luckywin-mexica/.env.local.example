# Supabase project values (Project Settings > API in your Supabase dashboard).
# These are PUBLIC values — safe to expose in the browser. Never put the
# service_role key here; that belongs only in the backend's .env.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-anon-public-key"

# URL of the Part 2 backend's API (include the /api prefix)
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
